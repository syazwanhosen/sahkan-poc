{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "functions": {
    "api/myinvois.ts": { "maxDuration": 60 }
  },
  "rewrites": [{ "source": "/api/myinvois/:path*", "destination": "/api/myinvois" }]
}
