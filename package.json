{
  "name": "sahkan-poc",
  "private": true,
  "version": "0.1.0",
  "description": "Sahkan e-invoicing web app: demo UI with sample data and a simulated MyInvois, plus a live mode on the real MyInvois API through a small server.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "artifact": "npm run build && node scripts/to-artifact.mjs"
  },
  "dependencies": {
    "jspdf": "2.5.2",
    "lucide-react": "0.453.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3"
  }
}
