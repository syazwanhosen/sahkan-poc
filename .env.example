# Copy to .env and fill in. These stay on the server (vite.config.ts): only VITE_* reaches the browser.
# On Vercel, set the same names in the project's Environment Variables instead.
# Without any credentials the app runs the simulated demo only.

# sandbox (preprod, the default) or production
MYINVOIS_ENV=sandbox

# Your ERP system, registered on the MyInvois portal (Taxpayer > ERP > Register ERP).
# Sandbox and production need separate registrations.
MYINVOIS_CLIENT_ID=
MYINVOIS_CLIENT_SECRET=

# Optional: an intermediary's ERP system, for the accountant view. It logs in "on behalf of" each
# client's TIN, so each client must first add the intermediary on their MyInvois profile.
MYINVOIS_INTERMEDIARY_CLIENT_ID=
MYINVOIS_INTERMEDIARY_CLIENT_SECRET=

# Optional: a digital signing certificate (PEM) and key. With both set, documents go as version
# 1.1 and are signed; without them, as version 1.0 with no signature. From a .p12 file:
#   openssl pkcs12 -in cert.p12 -clcerts -nokeys -out cert.pem
#   openssl pkcs12 -in cert.p12 -nocerts -out key.pem
MYINVOIS_CERT_FILE=
MYINVOIS_KEY_FILE=
MYINVOIS_KEY_PASSPHRASE=
# On Vercel, which has no files, paste the PEMs themselves instead. One line with \n works too.
MYINVOIS_CERT_PEM=
MYINVOIS_KEY_PEM=

# Required on Vercel, optional here: browsers must send this key to use the MyInvois server, and the
# app asks for it once. Use a long random value, such as: openssl rand -base64 32
MYINVOIS_ACCESS_KEY=

# Optional: force 1.0 or 1.1 instead of choosing by whether a certificate is set.
MYINVOIS_DOC_VERSION=

# Optional: extra root certificates (PEM) for networks that inspect TLS, such as Zscaler. Local only:
# Vercel ignores it.
# On a Mac: security find-certificate -a -c "Zscaler Root CA" -p /Library/Keychains/System.keychain > zscaler.pem
MYINVOIS_CA_FILE=

# Optional: other host names allowed to use the API (comma-separated), when the dev server is
# opened from another device with --host. Only this computer can by default.
MYINVOIS_ALLOWED_HOSTS=
